{
  "name": "bookmark-m",
  "description": "面向移动端触控体验的书签管理扩展，支持快速浏览、搜索、整理与编辑书签。",
  "private": true,
  "version": "1.8.8",
  "packageManager": "bun@1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "bun run typecheck && wxt build",
    "build:zip": "bun run typecheck && wxt zip",
    "typecheck": "bun check",
    "postinstall": "wxt prepare",
    "reload": "reload-extension \"Bookmark M\"",
    "build:reload": "bun run build && bun run reload"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.1.37",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "basic-ftp": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "wxt": "^0.21.4",
    "vite": "^8.3.5",
    "web-ext": "^10.8.0",
    "reload-extension": "^0.3.6"
  }
}
